# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Xposed 框架按 assets/xposed_init 中的类名反射实例化入口：必须保留类、
# 无参构造，以及接口方法名（compileOnly 的 IXposedHookLoadPackage 不在
# R8 的 library classpath 中，改名会让接口分派失效）。
-keep class org.krvyft.agentcall.hook.HookEntry { *; }

# 入口包内由发现/注册逻辑按名引用的类型保留名字，便于诊断与后续 Hook 接线。
-keepnames class org.krvyft.agentcall.hook.** { *; }

# Telecom 的 Call.Callback 音频路由回调是 @SystemApi：公开 SDK 里看不到，但运行时存在，
# 我们按 JVM 签名声明以接受框架虚分派。R8 看不到这条虚调用，必须显式保留成员
# （onStateChanged 等公开回调是库方法覆写，R8 自己会保留；这里只补隐藏的两个）。
-keepclassmembers class org.krvyft.agentcall.hook.** {
    public void onCallAudioStateChanged(android.telecom.Call, android.telecom.CallAudioState);
    public void onCallEndpointChanged(android.telecom.Call, android.telecom.CallEndpoint);
}

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}