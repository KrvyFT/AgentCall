<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/calibration_intro" />

        <TextView
            android:id="@+id/calibration_environment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calibration_environment_prefix" />

        <TextView
            android:id="@+id/calibration_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calibration_state_prefix" />

        <TextView
            android:id="@+id/calibration_environment_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calibration_environment_missing_note"
            android:textSize="12sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/step_downlink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calibration_step_downlink" />

        <CheckBox
            android:id="@+id/step_peer_heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_step_peer_heard" />

        <CheckBox
            android:id="@+id/step_mic_isolated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_step_mic_isolated" />

        <CheckBox
            android:id="@+id/step_manual_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_step_manual_restore" />

        <CheckBox
            android:id="@+id/step_process_failure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_step_process_failure" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calibration_note"
            android:textSize="12sp" />

        <Button
            android:id="@+id/button_refresh_environment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calibration_button_refresh" />

        <Button
            android:id="@+id/button_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_button_reset" />
    </LinearLayout>
</ScrollView>
