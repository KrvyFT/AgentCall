<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_intro" />

        <TextView
            android:id="@+id/status_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_status_root_prefix" />

        <TextView
            android:id="@+id/status_hook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_status_hook_prefix" />

        <TextView
            android:id="@+id/status_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_status_service_prefix" />

        <TextView
            android:id="@+id/status_calibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_status_calibration_prefix" />

        <TextView
            android:id="@+id/status_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_status_config_prefix" />

        <TextView
            android:id="@+id/status_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_status_session_prefix" />

        <TextView
            android:id="@+id/text_blockers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/main_note_no_blockers" />

        <TextView
            android:id="@+id/text_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_button_start" />

        <Button
            android:id="@+id/button_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_button_stop" />

        <Button
            android:id="@+id/button_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_button_retry" />

        <Button
            android:id="@+id/button_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_button_notification" />

        <Button
            android:id="@+id/button_calibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_button_calibration" />

        <Button
            android:id="@+id/button_takeover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_button_takeover" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_note_device"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
