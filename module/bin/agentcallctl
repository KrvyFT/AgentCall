#!/system/bin/sh
# AgentCall 固定命令包装器（spec §6.4 / 任务 8；任务 11B 新增 restart）。
#
# 设计边界：
# - 只转发固定六条命令给 org.krvyft.agentcall.bridge.AgentCallCli，没有任意 RPC、没有任意 shell。
# - restart 是模块侧控制动作（不是 AgentCallCli 命令）：写 root 私有重启请求标记，再执行
#   固定 CLI shutdown 让桥接干净退出；service.sh 在本次开机的有限循环内消费标记并重新
#   拉起桥接。它不接受参数，也不会把 restart 转发给 CLI。
# - 配置写入只从 stdin 进入。本脚本从不接收、拼接或回显配置内容：密钥不可能出现在
#   进程 argv、URL 或日志中。调用方（WebUI）把补丁 JSON 写入 root 私有文件后重定向 stdin：
#     agentcallctl config-set < /data/adb/agentcall/inbox/config-set.json
# - 本脚本不提供 base64/echo 之类的“保密”伪装，也从不读取或回显 stdin 内容。
# - 错误一律输出单行机器可读 JSON；成功输出 CLI 的 JSON，调用方据此判定。
#
# 退出码与 CLI 对齐：0 成功；1 服务端错误；2 用法/负载错误；3 传输失败。

set -u
umask 077

# $0 可能是不含斜杠的相对调用；显式解析，避免百分号斜杠展开得到错误目录。
case "$0" in
    */*)
        SCRIPT_DIR=${0%/*}
        ;;
    *)
        resolved=$(command -v "$0" 2>/dev/null || printf '%s' "$0")
        case "$resolved" in
            */*) SCRIPT_DIR=${resolved%/*} ;;
            *) SCRIPT_DIR=. ;;
        esac
        ;;
esac
MODDIR=$SCRIPT_DIR/..
# 测试/诊断注入点（与 service.sh/uninstall.sh 同名）：默认值就是真机路径；覆盖只改变
# 本脚本读写标记与启动固定 CLI 的路径，不引入任意命令执行。
DATA_ROOT=${AGENTCALL_DATA_ROOT:-/data/adb/agentcall}
APP_PROCESS=${AGENTCALL_APP_PROCESS:-/system/bin/app_process}
INBOX_DIR=$DATA_ROOT/inbox
LOG_DIR=$DATA_ROOT/logs
SERVICE_PID_FILE=$DATA_ROOT/service.pid
RESTART_REQUEST_FILE=$DATA_ROOT/restart.requested
MAX_PID_DIGITS=7
BRIDGE_JAR=$MODDIR/bridge/agentcall-bridge.jar
MAIN_CLASS=org.krvyft.agentcall.bridge.AgentCallCli

emit_error() {
    code=$1
    message=$2
    status=${3:-1}
    printf '{"error":{"code":"%s","message":"%s"}}\n' "$code" "$message"
    exit "$status"
}

if [ "$#" -lt 1 ]; then
    emit_error "usage_invalid" "usage: status | config-get | config-set (JSON on stdin) | pair [packageName] | diagnose | shutdown | restart" 2
fi

COMMAND=$1
case "$COMMAND" in
    status|config-get|config-set|diagnose|shutdown|restart)
        if [ "$#" -ne 1 ]; then
            emit_error "usage_invalid" "$COMMAND takes no arguments; config-set reads JSON from stdin" 2
        fi
        ;;
    pair)
        if [ "$#" -gt 2 ]; then
            emit_error "usage_invalid" "pair takes at most one package name" 2
        fi
        if [ "$#" -eq 2 ]; then
            case "$2" in
                ""|.*|*.|*..*) emit_error "payload_invalid" "package name is invalid" 2 ;;
                *[!A-Za-z0-9._]*) emit_error "payload_invalid" "package name is invalid" 2 ;;
            esac
        fi
        ;;
    *)
        emit_error "usage_invalid" "unknown command; allowed: status config-get config-set pair diagnose shutdown restart" 2
        ;;
esac

# 配对、写入与关闭都要求 root；非 root 时 CLI 也会拒绝，这里先给出机器可读原因。
if [ "$(id -u 2>/dev/null)" != "0" ]; then
    emit_error "cli_requires_root" "agentcallctl must run as root" 2
fi

if [ ! -f "$BRIDGE_JAR" ]; then
    emit_error "bridge_container_missing" "module bridge runtime container is missing" 3
fi
if [ ! -x "$APP_PROCESS" ]; then
    emit_error "app_process_missing" "app_process is unavailable on this system" 3
fi

# root 私有目录 0700。WebUI 只往 inbox 写受控临时文件；agentcallctl 也在这里确保目录存在。
mkdir -p "$DATA_ROOT" "$INBOX_DIR" "$LOG_DIR" 2>/dev/null
chmod 0700 "$DATA_ROOT" "$INBOX_DIR" "$LOG_DIR" 2>/dev/null

run_cli() {
    "$APP_PROCESS" -Djava.class.path="$BRIDGE_JAR" /system/bin --nice-name=agentcall-cli "$MAIN_CLASS" "$@"
}

# 重启请求必须有一个“活着的接收者”。service.pid 由 service.sh 写（单行十进制 PID）；
# 这里按 cmdline 核验确实是 service.sh，避免 PID 复用把请求写进另一个实例。
verified_service_pid() {
    [ -f "$SERVICE_PID_FILE" ] || return 1
    raw=$(head -n 1 "$SERVICE_PID_FILE" 2>/dev/null)
    case "$raw" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${#raw}" -le "$MAX_PID_DIGITS" ] || return 1
    candidate=$(printf '%s' "$raw" | tr -cd '0-9')
    [ "$candidate" -gt 1 ] || return 1
    [ -d "/proc/$candidate" ] || return 1
    cmdline=$(tr '\000' ' ' < "/proc/$candidate/cmdline" 2>/dev/null)
    case "$cmdline" in
        *service.sh*) printf '%s\n' "$candidate"; return 0 ;;
    esac
    return 1
}

# 模块侧重启（I2）：
# 1. remove/disable 标记存在时拒绝——已移除/停用的模块不得被重启请求复活；
# 2. service.sh 不在运行则明确拒绝（本次开机已没有重启循环，只能重启设备）；
# 3. 先写重启请求（内容是 service.sh 的 PID），再执行固定 CLI shutdown 让它干净退出；
#    shutdown 失败则收回请求，绝不留下未来会生效的标记；
# 4. 成功只宣称“已请求”；实际重新拉起由 service.sh 的有限循环完成。
restart_bridge() {
    if [ -f "$MODDIR/remove" ] || [ -f "$MODDIR/disable" ]; then
        emit_error "module_disabled" "module is disabled or marked for removal; restart is not allowed" 2
    fi
    service_pid=$(verified_service_pid) || emit_error "service_not_running" "service.sh is not running; the bridge can only be restarted within an active boot (reboot the device)" 3
    temporary="$RESTART_REQUEST_FILE.tmp.$$"
    if ! printf '%s\n' "$service_pid" > "$temporary" 2>/dev/null; then
        rm -f "$temporary" 2>/dev/null
        emit_error "restart_request_failed" "cannot write the restart request under the root private data directory" 3
    fi
    chmod 0600 "$temporary" 2>/dev/null
    if ! mv -f "$temporary" "$RESTART_REQUEST_FILE" 2>/dev/null; then
        rm -f "$temporary" 2>/dev/null
        emit_error "restart_request_failed" "cannot publish the restart request under the root private data directory" 3
    fi
    if ! run_cli shutdown > /dev/null 2>&1; then
        rm -f "$RESTART_REQUEST_FILE" 2>/dev/null
        emit_error "restart_unconfirmed" "bridge did not accept the shutdown request; nothing was restarted" 3
    fi
    printf '{"restart":"requested"}\n'
    exit 0
}

case "$COMMAND" in
    config-set)
        # stdin 只来自调用方的重定向；内容不经过任何 shell 拼接或回显。
        run_cli config-set
        result=$?
        # 只清理本模块固定的 inbox 文件，不接触其它路径。
        rm -f "$INBOX_DIR/config-set.json" 2>/dev/null
        exit "$result"
        ;;
    pair)
        if [ "$#" -eq 2 ]; then
            run_cli pair "$2"
        else
            run_cli pair
        fi
        exit $?
        ;;
    restart)
        restart_bridge
        ;;
    *)
        run_cli "$COMMAND"
        exit $?
        ;;
esac
